{
  "name": "quiz-duel",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --env-interface CloudflareBindings",
    "test": "esbuild tests/game-flow.ts --bundle --platform=node --format=esm --outfile=.wrangler/test-game.mjs && node .wrangler/test-game.mjs",
    "test:api": "bash scripts/test-api.sh",
    "test:browser": "playwright test tests/playwright-verification.spec.ts --workers=1"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "hono": "^4.13.17",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@hono/cli": "^1.0.0-rc.9",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "wrangler": "^4.158.0"
  }
}
